# Dockerfile.sandbox
# Fork of open-webui/open-terminal with a PRIVATE Docker daemon (dockerd) bundled.
# Designed to run under the Sysbox runtime (runtime: sysbox-runc) so the
# nested dockerd is fully isolated from the host - no host docker.sock mount
# is required or supported by this variant.
#
# Base image already bundles Docker CLI + Compose + Buildx (see upstream README).
# This file only ADDS the daemon (dockerd) and a wrapper entrypoint that starts
# it before handing off to the original open-terminal entrypoint.

FROM ghcr.io/open-webui/open-terminal:latest

USER root

# Install Docker Engine (dockerd) - CLI/Compose/Buildx are already present in
# the base image, we only need the daemon itself for nested Docker-in-Docker.
# get.docker.com also creates the "docker" system group as a side effect.
RUN curl -fsSL https://get.docker.com | sh \
    && rm -rf /var/lib/apt/lists/*

# Add "user" to the "docker" group AT BUILD TIME (not via a runtime usermod
# in entrypoint.sh). Group membership is resolved once when a process is
# created; exec() preserves the calling process's existing credentials, so
# a runtime usermod can't retroactively fix the group list of the already-
# running entrypoint chain. Baking it into the image means every process
# from PID1 onward has correct group membership from the start - no sudo,
# no `newgrp docker`, no per-session activation needed.
RUN usermod -aG docker user

COPY entrypoint-dind.sh /usr/local/bin/entrypoint-dind.sh
RUN chmod +x /usr/local/bin/entrypoint-dind.sh

# Keep original user for the app process; dockerd itself is started as root
# via sudo inside entrypoint-dind.sh, then privileges drop back for the app.
USER user

# IMPORTANT: keep tini (from the base image) as PID1. The sandbox forks
# several long-lived children (dockerd, containerd, dnsmasq, open-terminal),
# and without a proper init/reaper, exited children become zombies that
# still satisfy kill(pid, 0) checks - causing dockerd/containerd to falsely
# report "process with PID N is still running" on subsequent starts.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-dind.sh"]
